package servidor.entidades;

import java.util.Collections;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;


public class Pack {
    private final Species species;
    private final Team team;
    private final List<Animal> members = new CopyOnWriteArrayList<>();

    public Pack(Species species, Team team) {
        this.species = species;
        this.team = team;
    }

    public void add(Animal a) { members.add(a); }

    public Species getSpecies() { return species; }
    public Team getTeam() { return team; }
    public List<Animal> getMembers() { return Collections.unmodifiableList(members); }

    public int aliveCount() {
        int n = 0;
        for (Animal a : members) if (a.lifeState()) n++;
        return n;
    }

    public void coffeUP() {
        for (Animal a : members) if (a.lifeState()) a.dmgUP();
    }

    public void healAll() {
        for (Animal a : members) if (a.lifeState()) a.heal();
    }
}

