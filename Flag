package servidor.entidades;

public class Flag extends Item {

    public final Team owner;
    public final String color;

    public Flag(int ID, String type, Team owner, String color, double x, double y) {
        super(ID, type, true, x, y);
        this.owner = owner;
        this.color = color;
    }
    
    @Override
    public void dissapear(){
        System.out.println ("La bandera se ha recogido");
        this.x = -1;
        this.y = -1;
        this.taken.set(false);
        //Metodo de gamesession para la victoria del equipo que la recoja 
    }
}
