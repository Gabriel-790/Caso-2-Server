package servidor.entidades;

public abstract class Entity {
    private final int ID;
    private final String type;
    public volatile double x;
    public volatile double y;

    protected Entity (int ID, String type, double x, double y){
        this.ID = ID;
        this.type = type;
        this.x = x;
        this.y = y;
    }

    public double distanceTo (Entity target){
        return Math.hypot(x - target.x, y - target.y);
    }

    public int getId(){
        return this.ID;
    }

    public String getType(){
        return this.type;
    }

}

