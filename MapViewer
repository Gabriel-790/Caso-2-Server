package servidor;

import com.google.gson.Gson;

import javax.swing.BorderFactory;
import javax.swing.JCheckBox;
import javax.swing.JComboBox;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.SwingUtilities;
import java.awt.BasicStroke;
import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.FlowLayout;
import java.awt.Font;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.Point;
import java.awt.RenderingHints;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.MouseMotionAdapter;
import java.awt.geom.Ellipse2D;
import java.awt.geom.Line2D;
import java.awt.geom.Path2D;
import java.awt.geom.Point2D;
import java.awt.geom.Rectangle2D;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.io.InputStream;
import java.io.StringReader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.Optional;
import java.util.function.Consumer;

public class MapViewer {

    static final int ZONE_COLUMNS = 4;
    static final int ZONE_ROWS = 3;
    static final double ZONE_WIDTH = 1000;
    static final double ZONE_HEIGHT = 700;
    static final double SNAP_DISTANCE = 60;
    private static final String DEFAULT_RESOURCE = "map.json";
    private static final int VIEW_ALL = -1;

    /** Ruta de patrulla tal como aparece en el JSON. */
    public static final class PatrolRoute {
        String id;
        boolean loop;
        int[] nodes;
    }

    private static final class RoutesFile {
        List<PatrolRoute> patrolRoutes;
    }

    public static void main(String[] args) throws IOException {
        String json = args.length > 0
                ? Files.readString(Path.of(args[0]), StandardCharsets.UTF_8)
                : readResource(DEFAULT_RESOURCE);

        MapGraph graph = MapLoader.load(new StringReader(json));
        RoutesFile file = new Gson().fromJson(json, RoutesFile.class);
        List<PatrolRoute> routes = (file == null || file.patrolRoutes == null)
                ? List.of() : file.patrolRoutes;

        SwingUtilities.invokeLater(() -> showWindow(graph, routes));
    }

    private static String readResource(String path) throws IOException {
        try (InputStream in = MapViewer.class.getResourceAsStream(path)) {
            if (in == null) {
                throw new FileNotFoundException("No se encontró " + path + " (¿está en src/main/resources?)");
            }
            return new String(in.readAllBytes(), StandardCharsets.UTF_8);
        }
    }

    private static void showWindow(MapGraph graph, List<PatrolRoute> routes) {
        JLabel status = new JLabel(summary(graph, routes));
        status.setBorder(BorderFactory.createEmptyBorder(4, 8, 4, 8));

        MapPanel panel = new MapPanel(graph, status::setText);

        JComboBox<String> viewCombo = new JComboBox<>();
        viewCombo.addItem("Mundo (todas las zonas)");
        for (int z = 0; z < ZONE_COLUMNS * ZONE_ROWS; z++) {
            viewCombo.addItem("Zona " + z);
        }
        viewCombo.addActionListener(e ->
                panel.setViewZone(viewCombo.getSelectedIndex() - 1));

        JComboBox<String> routeCombo = new JComboBox<>();
        routeCombo.addItem("(ninguna)");
        for (PatrolRoute r : routes) {
            routeCombo.addItem(r.id);
        }
        routeCombo.addActionListener(e -> {
            int i = routeCombo.getSelectedIndex();
            panel.setSelectedRoute(i <= 0 ? null : routes.get(i - 1));
        });

        JCheckBox idsBox = new JCheckBox("Mostrar IDs");
        idsBox.addActionListener(e -> panel.setShowIds(idsBox.isSelected()));

        JPanel toolbar = new JPanel(new FlowLayout(FlowLayout.LEFT));
        toolbar.add(new JLabel("Vista:"));
        toolbar.add(viewCombo);
        toolbar.add(new JLabel("Ruta:"));
        toolbar.add(routeCombo);
        toolbar.add(idsBox);

        JFrame frame = new JFrame("Visor de mapa - Bosque de Costa Rica");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(toolbar, BorderLayout.NORTH);
        frame.add(panel, BorderLayout.CENTER);
        frame.add(status, BorderLayout.SOUTH);
        frame.setSize(1280, 800);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

    private static String summary(MapGraph graph, List<PatrolRoute> routes) {
        return "Nodos: " + graph.getNodes().size()
                + " | Aristas: " + graph.getEdges().size()
                + " | Zonas con nodos: " + graph.zones().size()
                + " | Conexo: " + (graph.isConnected() ? "sí" : "NO")
                + " | Rutas de patrulla: " + routes.size()
                + "   (mueve el mouse o haz clic para probar el snap)";
    }

    public static class MapPanel extends JPanel {

        private static final int MARGIN = 20;
        private static final Color SNAP_COLOR = new Color(220, 30, 30);
        private static final Color ROUTE_COLOR = new Color(190, 40, 190);
        private static final Color CROSS_ZONE_COLOR = new Color(240, 140, 0);

        private final MapGraph graph;
        private final Consumer<String> status;
        private int viewZone = VIEW_ALL;
        private boolean showIds;
        private PatrolRoute selectedRoute;
        private Point2D clickPoint;
        private MapGraph.SnapResult snapResult;

        public MapPanel(MapGraph graph, Consumer<String> status) {
            this.graph = graph;
            this.status = status;
            setBackground(new Color(245, 245, 245));

            addMouseMotionListener(new MouseMotionAdapter() {
                @Override public void mouseMoved(MouseEvent e) {
                    Point2D w = toWorld(e.getPoint());
                    MapPanel.this.status.accept(String.format("x = %.0f, y = %.0f   |   %s",
                            w.getX(), w.getY(), zoneLabel(w)));
                }
            });
            addMouseListener(new MouseAdapter() {
                @Override public void mouseClicked(MouseEvent e) {
                    onClick(toWorld(e.getPoint()));
                }
            });
        }

        public void setViewZone(int zone) { this.viewZone = zone; repaint(); }
        public void setShowIds(boolean show) { this.showIds = show; repaint(); }
        public void setSelectedRoute(PatrolRoute route) { this.selectedRoute = route; repaint(); }

        private void onClick(Point2D world) {
            clickPoint = world;
            Optional<MapGraph.SnapResult> snap = graph.snap(world, SNAP_DISTANCE);
            snapResult = snap.orElse(null);
            if (snap.isPresent()) {
                MapGraph.SnapResult s = snap.get();
                status.accept(String.format(
                        "Clic (%.0f, %.0f) -> snap en arista %d-%d, t = %.2f, punto (%.0f, %.0f), distancia %.1f",
                        world.getX(), world.getY(), s.edge().a(), s.edge().b(), s.t(),
                        s.point().getX(), s.point().getY(), s.distance()));
            } else {
                status.accept(String.format(
                        "Clic (%.0f, %.0f) -> ningún camino a menos de %.0f unidades (el servidor ignoraría el comando)",
                        world.getX(), world.getY(), SNAP_DISTANCE));
            }
            repaint();
        }



        private Rectangle2D viewBounds() {
            if (viewZone == VIEW_ALL) {
                return new Rectangle2D.Double(0, 0, ZONE_COLUMNS * ZONE_WIDTH, ZONE_ROWS * ZONE_HEIGHT);
            }
            return zoneRect(viewZone);
        }

        private static Rectangle2D zoneRect(int zone) {
            int col = zone % ZONE_COLUMNS;
            int row = zone / ZONE_COLUMNS;
            return new Rectangle2D.Double(col * ZONE_WIDTH, row * ZONE_HEIGHT, ZONE_WIDTH, ZONE_HEIGHT);
        }

        private double scale() {
            Rectangle2D v = viewBounds();
            double sx = (getWidth() - 2.0 * MARGIN) / v.getWidth();
            double sy = (getHeight() - 2.0 * MARGIN) / v.getHeight();
            return Math.max(1e-6, Math.min(sx, sy));
        }

        private double offsetX() {
            Rectangle2D v = viewBounds();
            return (getWidth() - v.getWidth() * scale()) / 2 - v.getX() * scale();
        }

        private double offsetY() {
            Rectangle2D v = viewBounds();
            return (getHeight() - v.getHeight() * scale()) / 2 - v.getY() * scale();
        }

        private Point2D toScreen(double x, double y) {
            return new Point2D.Double(x * scale() + offsetX(), y * scale() + offsetY());
        }

        private Point2D toWorld(Point p) {
            return new Point2D.Double((p.x - offsetX()) / scale(), (p.y - offsetY()) / scale());
        }

        private static String zoneLabel(Point2D w) {
            int col = (int) Math.floor(w.getX() / ZONE_WIDTH);
            int row = (int) Math.floor(w.getY() / ZONE_HEIGHT);
            if (col < 0 || col >= ZONE_COLUMNS || row < 0 || row >= ZONE_ROWS) {
                return "fuera del mapa";
            }
            return "zona " + (row * ZONE_COLUMNS + col);
        }

        private static Color zoneColor(int zone, float saturation, float brightness) {
            return Color.getHSBColor(zone / (float) (ZONE_COLUMNS * ZONE_ROWS), saturation, brightness);
        }

        

        @Override
        protected void paintComponent(Graphics g0) {
            super.paintComponent(g0);
            Graphics2D g = (Graphics2D) g0.create();
            g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

            drawZones(g);
            drawEdges(g);
            drawSelectedRoute(g);
            drawNodes(g);
            drawSnap(g);
            g.dispose();
        }

        private void drawZones(Graphics2D g) {
            g.setFont(getFont().deriveFont(Font.BOLD, 13f));
            for (int z = 0; z < ZONE_COLUMNS * ZONE_ROWS; z++) {
                Rectangle2D r = zoneRect(z);
                Point2D tl = toScreen(r.getX(), r.getY());
                Point2D br = toScreen(r.getMaxX(), r.getMaxY());
                Rectangle2D screen = new Rectangle2D.Double(
                        tl.getX(), tl.getY(), br.getX() - tl.getX(), br.getY() - tl.getY());
                g.setColor(zoneColor(z, 0.10f, 0.98f));
                g.fill(screen);
                g.setColor(new Color(150, 150, 150));
                g.setStroke(new BasicStroke(1f));
                g.draw(screen);
                g.setColor(new Color(90, 90, 90));
                g.drawString("Zona " + z, (float) tl.getX() + 6, (float) tl.getY() + 16);
            }
        }

        private void drawEdges(Graphics2D g) {
            for (MapGraph.Edge e : graph.getEdges()) {
                MapNode a = graph.getNode(e.a());
                MapNode b = graph.getNode(e.b());
                Point2D pa = toScreen(a.x(), a.y());
                Point2D pb = toScreen(b.x(), b.y());
                boolean crossZone = a.zone() != b.zone();
                g.setColor(crossZone ? CROSS_ZONE_COLOR : new Color(110, 110, 110));
                g.setStroke(new BasicStroke(crossZone ? 4f : 2f));
                g.draw(new Line2D.Double(pa, pb));
            }
        }

        private void drawSelectedRoute(Graphics2D g) {
            if (selectedRoute == null || selectedRoute.nodes == null || selectedRoute.nodes.length < 2) {
                return;
            }
            Path2D path = new Path2D.Double();
            for (int i = 0; i < selectedRoute.nodes.length; i++) {
                MapNode n = graph.getNode(selectedRoute.nodes[i]);
                Point2D p = toScreen(n.x(), n.y());
                if (i == 0) {
                    path.moveTo(p.getX(), p.getY());
                } else {
                    path.lineTo(p.getX(), p.getY());
                }
            }
            if (selectedRoute.loop) {
                path.closePath();
            }
            g.setColor(ROUTE_COLOR);
            g.setStroke(new BasicStroke(3f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND,
                    10f, new float[] {9f, 7f}, 0f));
            g.draw(path);

            g.setStroke(new BasicStroke(1f));
            g.setFont(getFont().deriveFont(Font.BOLD, 12f));
            for (int i = 0; i < selectedRoute.nodes.length; i++) {
                MapNode n = graph.getNode(selectedRoute.nodes[i]);
                Point2D p = toScreen(n.x(), n.y());
                g.setColor(ROUTE_COLOR);
                g.drawString(String.valueOf(i + 1), (float) p.getX() + 8, (float) p.getY() - 8);
            }
        }

        private void drawNodes(Graphics2D g) {
            double radius = viewZone == VIEW_ALL ? 3.5 : 6;
            g.setStroke(new BasicStroke(1f));
            g.setFont(getFont().deriveFont(10f));
            for (MapNode n : graph.getNodes()) {
                Point2D p = toScreen(n.x(), n.y());
                Ellipse2D dot = new Ellipse2D.Double(
                        p.getX() - radius, p.getY() - radius, radius * 2, radius * 2);
                g.setColor(zoneColor(n.zone(), 0.75f, 0.70f));
                g.fill(dot);
                g.setColor(Color.DARK_GRAY);
                g.draw(dot);
                if (showIds) {
                    g.drawString(String.valueOf(n.id()), (float) p.getX() + 6, (float) p.getY() + 12);
                }
            }
        }

        private void drawSnap(Graphics2D g) {
            if (clickPoint == null) {
                return;
            }
            Point2D c = toScreen(clickPoint.getX(), clickPoint.getY());
            g.setStroke(new BasicStroke(2f));
            g.setColor(new Color(30, 90, 220));
            g.draw(new Line2D.Double(c.getX() - 6, c.getY() - 6, c.getX() + 6, c.getY() + 6));
            g.draw(new Line2D.Double(c.getX() - 6, c.getY() + 6, c.getX() + 6, c.getY() - 6));
            if (snapResult != null) {
                Point2D s = toScreen(snapResult.point().getX(), snapResult.point().getY());
                g.setColor(SNAP_COLOR);
                g.draw(new Line2D.Double(c, s));
                g.fill(new Ellipse2D.Double(s.getX() - 5, s.getY() - 5, 10, 10));
            }
        }
    }
}
