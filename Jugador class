package servidor.entidades;

public class Jugador extends Animal{

    public Jugador (int ID, Species species, Team team, Pack group, double x, double y, Arena world){
        super(ID, species, team, group, x, y, Reglas.PLAYER_HEALTH, Reglas.PLAYER_INITIAL_DMG, world);
    }

    public int getPackNumber(){
        return Reglas.PLAYER_PACK_SIZE;
    }

    
    public boolean pickup(Item item){
        if (!(item instanceof Coffecup)) return false;
        if (this.distanceTo(item) > Reglas.PICK_UP_RADIUS) return false;
        if (!item.taken.compareAndSet(false, true)) return false;   // otro hilo llego primero
        item.dissapear();
        group.coffeUP();
        return true;
    }


    @Override
    protected void behave() {
        Animal t = manualTarget;
        if (t == null) return;
        if (!t.lifeState()) { manualTarget = null; return; }
        if (distanceTo(t) <= Reglas.ATTACK_RADIUS) {
            stopMoving();
            tryAttack(t);
        } else {
            moveTo(t.x, t.y);   
        }
    }

    @Override
    protected void afterStep() {
        world.playerStepped(this);   
    }
}
