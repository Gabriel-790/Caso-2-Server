package servidor.entidades;

import java.util.concurrent.ThreadLocalRandom;

public class Bot extends Animal{

    public Bot (int ID, Species species, Pack group, double x, double y, Arena world){
        super(ID, species, Team.BOT, group, x, y, Reglas.BOT_HEALTH, Reglas.BOT_INITIAL_DMG, world);
    }

    public int getPackNumber(){
        return Reglas.BOT_PACK_SIZE;
    }

    @Override
    protected void behave() {
        Animal enemy = world.nearestPlayerAnimal(this, Reglas.ATTACK_RADIUS);
        if (enemy != null) {
            stopMoving();
            tryAttack(enemy);
            return;
        }
        if (!isMoving()) {
            ThreadLocalRandom r = ThreadLocalRandom.current();
            moveTo(x + r.nextDouble(-80, 80), y + r.nextDouble(-80, 80));
        }
    }
}

